{
  "name": "atlas-of-small-weathers",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Turn live weather into slow, abstract paintings. A generative art atlas with pluggable painterly schools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mpinedaj/atlas-of-small-weathers.git"
  },
  "homepage": "https://github.com/mpinedaj/atlas-of-small-weathers",
  "keywords": [
    "generative-art",
    "webgl2",
    "weather",
    "glsl",
    "open-source",
    "painting"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
